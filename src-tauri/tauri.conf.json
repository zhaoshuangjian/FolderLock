{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FolderLock",
  "version": "0.1.0",
  "identifier": "app.folderlock.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "node tools/dev-server.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FolderLock",
        "width": 460,
        "height": 720,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
